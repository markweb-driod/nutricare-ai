# NutriCare AI Root Environment Configuration
APP_ENV=local
APP_NAME=NutriCare-AI

# Services Ports & Endpoints
FRONTEND_PORT=3000
BACKEND_PORT=8080
ML_SERVICE_PORT=8000

# Backend Connection to ML Microservice
ML_SERVICE_URL=http://127.0.0.1:8000

# Frontend Connection to Backend REST API
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080/api/v1

# Optional Database & Cache (Used for Docker / Production)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nutricare_db
DB_USERNAME=nutricare_admin
DB_PASSWORD=secure_nutricare_pwd

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
